<UserControl
    x:Class="TelegramBotMinecraft.Avalonia.UsersView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TelegramBotMinecraft.Avalonia.ViewModels"
    d:DesignHeight="730"
    d:DesignWidth="1220"
    x:DataType="vm:UsersViewModel"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="*, Auto, 275">

        <GroupBox
            Grid.Column="0"
            Margin="3"
            Padding="0"
            FontFamily="Default"
            FontSize="15"
            Header="Разрешения пользователей">
            <Grid RowDefinitions="*, Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*">

                    <GroupBox
                        Grid.Column="0"
                        Margin="3,0,10,0"
                        Padding="0"
                        FontFamily="Default"
                        FontSize="15"
                        Header="Сервера">
                        <Grid Margin="0" RowDefinitions="*, Auto">
                            <DataGrid
                                x:Name="ServersGrid"
                                Grid.Row="0"
                                Margin="0"
                                AutoGenerateColumns="False"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CanUserResizeColumns="False"
                                FontSize="12"
                                GridLinesVisibility="All"
                                HorizontalScrollBarVisibility="Disabled"
                                IsReadOnly="False"
                                ItemsSource="{Binding Servers}"
                                SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="Название" />
                                    <DataGridTemplateColumn Width="Auto" Header="Выбор">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsChecked}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                LastChildFill="False">
                                <Button
                                    Command="{Binding DisableAllServersCommand}"
                                    Content="Отключить все"
                                    DockPanel.Dock="Left" />
                                <Button
                                    Command="{Binding EnableAllServersCommand}"
                                    Content="Включить все"
                                    DockPanel.Dock="Right" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox
                        Grid.Column="2"
                        Margin="10,0,3,0"
                        Padding="0"
                        FontFamily="Default"
                        FontSize="15"
                        Header="Команды">
                        <Grid Margin="0" RowDefinitions="*, Auto">
                            <DataGrid
                                x:Name="CommandsGrid"
                                Grid.Row="0"
                                Margin="0"
                                AutoGenerateColumns="False"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CanUserResizeColumns="False"
                                FontSize="12"
                                GridLinesVisibility="All"
                                HorizontalScrollBarVisibility="Disabled"
                                IsReadOnly="False"
                                ItemsSource="{Binding Commands}"
                                SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="Название" />
                                    <DataGridTemplateColumn Width="Auto" Header="Выбор">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsChecked}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                LastChildFill="False">
                                <Button
                                    Command="{Binding DisableAllCommandsCommand}"
                                    Content="Отключить все"
                                    DockPanel.Dock="Left" />
                                <Button
                                    Command="{Binding EnableAllCommandsCommand}"
                                    Content="Включить все"
                                    DockPanel.Dock="Right" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>

                </Grid>
                <Button
                    Grid.Row="1"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding SavePermissionsCommand}"
                    Content="Сохранить" />
            </Grid>

        </GroupBox>

        <Grid Grid.Column="2">
            <GroupBox
                Margin="3,3,3,3"
                Padding="0"
                HorizontalAlignment="Stretch"
                FontFamily="Default"
                FontSize="15"
                Header="Пользователи">
                <Grid RowDefinitions="*, Auto, Auto">
                    <DataGrid
                        x:Name="UsersGrid"
                        Grid.Row="0"
                        Width=" 250"
                        Margin="0,0,0,10"
                        AutoGenerateColumns="False"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CanUserResizeColumns="False"
                        GridLinesVisibility="All"
                        HorizontalScrollBarVisibility="Disabled"
                        IsReadOnly="True"
                        ItemsSource="{Binding Users}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="Имя" />
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Id}"
                                Header="Id" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel
                        Grid.Row="1"
                        Width="250"
                        Margin="0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="5">
                        <Button Content="Изменить" FontSize="12" />
                        <Button Content="Сохранить" FontSize="12" />
                        <Button
                            Command="{Binding DeleteUserCommand}"
                            Content="Удалить"
                            FontSize="12" />
                    </StackPanel>

                    <GroupBox
                        Grid.Row="2"
                        Width="250"
                        Margin="3,5,3,0"
                        Padding="0"
                        FontFamily="Default"
                        FontSize="15"
                        Header="Новый пользователь">
                        <StackPanel Spacing="5">
                            <TextBox
                                HorizontalAlignment="Stretch"
                                IsReadOnly="False"
                                PlaceholderText="Имя"
                                Text="{Binding UserName}" />
                            <TextBox
                                HorizontalAlignment="Stretch"
                                IsReadOnly="False"
                                PlaceholderText="Id"
                                Text="{Binding UserId}" />
                            <Button
                                Margin="0,5,0,0"
                                Command="{Binding AddUserCommand}"
                                Content="Добавить" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
