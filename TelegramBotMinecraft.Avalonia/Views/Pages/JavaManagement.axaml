<UserControl
    x:Class="TelegramBotMinecraft.Avalonia.Views.JavaManagement"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TelegramBotMinecraft.Avalonia.ViewModels"
    d:DesignHeight="500"
    d:DesignWidth="800"
    x:DataType="vm:JavaManagementViewModel"
    mc:Ignorable="d">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="95"
                Height="28"
                Command="{Binding $parent[Window].((vm:JavaManagerWindowViewModel)DataContext).OpenJavaDownloaderWindowCommand}"
                Content="Добавить" />
            <Button
                Grid.Column="1"
                Width="95"
                Height="28"
                Margin="10,0,10,0"
                Command="{Binding DeleteSelectedJavaCommand}"
                Content="Удалить" />

            <Button
                Grid.Column="2"
                Width="95"
                Height="28"
                HorizontalAlignment="Right"
                Command="{Binding UpdateJavaListCommand}"
                Content="Обновить" />
        </Grid>

        <DataGrid
            x:Name="JavaGrid"
            Grid.Row="1"
            Margin="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            AutoGenerateColumns="False"
            BorderBrush="Gray"
            BorderThickness="1"
            CanUserResizeColumns="False"
            ColumnWidth="*"
            FontSize="12"
            GridLinesVisibility="All"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            ItemsSource="{Binding DownloadedJavaList}"
            SelectedItem="{Binding SelectedJava}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Version}"
                    Header="Версия" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Architecture}"
                    Header="Архитектура" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="800"
                    Binding="{Binding Path}"
                    Header="Путь" />
            </DataGrid.Columns>
        </DataGrid>

        <Button
            Grid.Row="2"
			Margin="0,10,0,0"
            Width="85"
            Height="28"
            HorizontalAlignment="Center"
            Background="#1F4E79"
            BorderBrush="#2A6496"
            Command="{Binding OkCommand}"
            Content="ОK"
            Foreground="#FFFFFF" />
    </Grid>
</UserControl>
