<UserControl
    x:Class="TelegramBotMinecraft.Avalonia.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TelegramBotMinecraft.Avalonia.ViewModels"
    d:DesignHeight="730"
    d:DesignWidth="1220"
    x:DataType="vm:SettingsViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *">
            <GroupBox
                Grid.Column="0"
                Margin="3"
                Padding="0"
                FontFamily="Default"
                FontSize="15"
                Header="Telegram">
                <StackPanel Grid.Row="0" Spacing="10">
                    <GroupBox
                        Padding="0"
                        FontFamily="Default"
                        FontSize="15"
                        Header="Настройки бота">
                        <StackPanel Spacing="8">
                            <DockPanel LastChildFill="True">
                                <TextBlock
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Text="BotToken:" />
                                <TextBox
                                    Padding="5,4"
                                    Classes="revealPasswordButton"
                                    PasswordChar="*"
                                    PlaceholderText="123456789:ABCdefGHljklMNOpqrSTUvwxYZ"
                                    RevealPassword="False"
                                    Text="{Binding Settings.BotToken}" />
                            </DockPanel>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.AutoBot}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Автозапуск бота" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.AutoReconnect}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Авторестарт бота" />
                            </StackPanel>
                            <Button
                                Margin="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Command="{Binding OffBotTelegramCommand}"
                                Content="{Binding StatusWorkTGBot}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        Padding="0"
                        FontFamily="Default"
                        FontSize="15"
                        Header="Прокси (SOCKS5, HTTP)">
                        <StackPanel Spacing="8">
                            <DockPanel LastChildFill="True">
                                <TextBlock
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Text="Хост / IP:" />
                                <TextBox
                                    Padding="5,4"
                                    PlaceholderText="127.0.0.1"
                                    Text="{Binding Settings.ProxyHost}" />
                            </DockPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Text="Port:" />
                                <TextBox
                                    Padding="5,4"
                                    PlaceholderText="1080"
                                    Text="{Binding Settings.ProxyPort}" />
                            </DockPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Text="Admin:" />
                                <TextBox
                                    Padding="5,4"
                                    PlaceholderText="Admin"
                                    Text="{Binding Settings.ProxyUsername}" />
                            </DockPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock
                                    Width="150"
                                    VerticalAlignment="Center"
                                    Text="Пароль:" />
                                <TextBox
                                    Padding="5,4"
                                    Classes="revealPasswordButton"
                                    PasswordChar="*"
                                    PlaceholderText="12345"
                                    RevealPassword="False"
                                    Text="{Binding Settings.ProxyPassword}" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid RowDefinitions="auto, *">
                    <GroupBox
                        Grid.Row="0"
                        Margin="3"
                        Padding="0"
                        FontFamily="Default"
                        FontSize="15"
                        Header="Основные">
                        <Grid RowDefinitions="*, auto">
                            <StackPanel Spacing="8">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.TrayOnStart}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Сворачивать в трей при запуске" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.RunAtStartup}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Запуск с Windows" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Settings.Notifications}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Всплывающие уведомления" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Автоматический выбор Java" />
                                </StackPanel>
                                <Grid>
                                    <Button
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding OpenJavaManagementWindowCommand}"
                                        Content="Управление Java" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox
                        Grid.Row="1"
                        Margin="3"
                        Padding="0"
                        FontFamily="Default"
                        FontSize="15"
                        Header="Консоль бота и приложения">
                        <AvaloniaEdit:TextEditor
                            x:Name="LogsBotAndProgram"
                            Grid.Row="0"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Document="{Binding LogsBotAndProgram, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="Normal"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ShowLineNumbers="True"
                            VerticalScrollBarVisibility="Auto"
                            WordWrap="False" />
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
        <Button
            Grid.Row="1"
            Margin="3"
            VerticalAlignment="Bottom"
            Background="#1F4E79"
            BorderBrush="#2A6496"
            Command="{Binding SaveSettingsCommand}"
            Content="Coxpaнить"
            Foreground="#FFFFFF" />
    </Grid>
</UserControl>
