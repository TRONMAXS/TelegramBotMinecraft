<Window
    x:Class="TelegramBotMinecraft.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:TelegramBotMinecraft.Avalonia"
    xmlns:vm="using:TelegramBotMinecraft.Avalonia.ViewModels"
    Title="Test"
    d:DesignHeight="730"
    d:DesignWidth="1220"
    x:DataType="vm:MainViewModel"
    CanResize="False"
    Icon="/Assets/TelegramBotMinecraft-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl
        Margin="3,3,3,3"
        SelectedIndex="0"
        Theme="{DynamicResource CardTabControl}">

        <TabControl.Styles>
            <Style Selector="TabItem">
                <Setter Property="FontSize" Value="14" />
            </Style>
        </TabControl.Styles>

        <TabItem x:Name="Console" Header="Консоль">
            <views:ConsoleView />
        </TabItem>

        <TabItem x:Name="Servers" Header="Сервера">
            <views:ServersView />
        </TabItem>

        <TabItem x:Name="Users" Header="Пользователи">
            <views:UsersView />
        </TabItem>

        <TabItem x:Name="Settings" Header="Настройки">
            <views:SettingsView />
        </TabItem>
    </TabControl>

</Window>
